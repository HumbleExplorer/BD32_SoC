# =============================================================================
# BD32 SoC .gitignore
# =============================================================================

# --- ModelSim / 仿真产物 ---
**/work/
**/transcript
**/*.wlf
**/*.vstf
**/wlft*
**/modelsim.ini
tb/sim_output.txt

# --- Vivado 工程（保留 .xpr + 约束 + IP .xci，忽略生成产物）---
BD32_SoC
!BD32_SoC/BD32_SoC.srcs/sources_1/ip/*/*.xci
# 实现工具文件（.dcp checkpoint / .rqs）
BD32_SoC/BD32_SoC.srcs/utils_1/
!**/*.xpr

# --- IP 仓库（外部 IP，不纳入版本管理）---
ip_repo/
doc/research/
# --- 第三方源码依赖（riscv-tests 等，获取后使用；不随仓库分发）---
third_party/

# --- 调试会话临时日志 ---
SDK/tools/ocd_*.txt

# --- SDK/isa（env 随仓库提交；rv32ui/rv32um/rv64ui/macros 由脚本从 third_party 同步）---
**/isa/*
!**/isa/env/

# --- 测试构建产物（build_asm.py / build_riscv_tests.py 生成，不入库；克隆后需先构建再跑测试）---
test_data/soc/c/*.mem
test_data/soc/c/*.uartbin
!**/mrom.*
test_data/riscv-tests/
test_data/custom_asm/*.dat
test_data/custom_asm/*.elf
test_data/custom_asm/*.dump

# --- Python ---
**/__pycache__/
*.pyc

# --- 本地编译产物（build/ 与 build_O*/build_clang_* 等优化变体目录，均不入库；克隆后由 build.py 重新生成）---
**/build*/

# --- FPGA 工具运行产物 ---
.Xil/
vivado*.jou
vivado*.log
vivado*.str
wave_analysis/

# --- JTAG/OpenOCD 内存镜像与临时脚本产物 ---
**/dtcm_crash.bin
**/dtcm_freeze.bin
**/*_freeze.bin

# --- 编辑器 / OS 临时文件 ---
**/~$*
.history/
.workbuddy/
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# --- 大二进制（波形 / 位流 / 检查点，不进仓库） ---
*.vcd
*.bit
*.dcp

# --- 回归脚本输出 ---
logs/

# --- 日志 ---
**/*.log

# --- 表格文档---
*.xlsx

# --- 归档 ---
archive/

# --- backup ---
**/*.bak

# --- 工具状态 ---
.mimosa/
# --- 临时/本地文件 ---
commit_msg.txt
*.rpt
BD32_SoC/BD32_SoC.srcs/constrs_1/new/BD32_floorplan.xdc
**/Memory_Log/*
# --- SymbiYosys 运行产物 ---
rtl/assert/formal/*_bmc/
rtl/assert/formal/*_prove/
rtl/assert/formal/*_cover/
